# KongreHub yapılandırması — tümü ortam değişkenlerinden okunur.
# Demo değerleridir; üretimde gizli anahtarları mutlaka değiştirin.
POSTGRES_USER=kongrehub
POSTGRES_PASSWORD=kongrehub
POSTGRES_DB=kongrehub

JWT_SECRET=change-me-please-this-is-a-demo-secret-0123456789
# 32 baytlık Ed25519 tohumu (hex). Üretmek için: openssl rand -hex 32
CERT_SIGNING_SEED=8f0e2c4a6b1d3f5e7a9c0b2d4f6e8a1c3b5d7f9e0a2c4e6b8d1f3a5c7e9b0d2f
PAYMENT_WEBHOOK_SECRET=whsec_demo_change_me
PUBLIC_URL=http://localhost:3000

# Demo modu: tek bir hakem atamasını geriye tarihleme ve saat kaydırma uçlarını açar
DEMO_MODE=true
JOB_INTERVAL=1m
LOG_LEVEL=info

# Simülatör: aynı tohum → aynı veri
SEED=42
LIVE_ENABLED=true
LIVE_INTERVAL=4s
